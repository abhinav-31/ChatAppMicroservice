CHAT_NOTIFICATION_SERVER_PORT=8082

# MONGODB CONFIGURATION
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=chat_notification

# EUREKA CLIENT
DEFAULT_ZONE=http://service-registry:8761/eureka
HOST_NAME=chat-notification-service

# REDIS CONFIG
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TYPE=redis

# RABBITMQ CONFIG
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672